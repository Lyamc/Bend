# Bend is not in GitHub Linguist yet: render .bend with the Python
# grammar (Bend is Python-shaped: def/match/case/#), keep it out of
# the language stats bar.
*.bend linguist-language=Python linguist-detectable=false
bench/checker/** linguist-vendored
*.lean linguist-detectable=false

# A core.autocrlf=true checkout rewrites these to CRLF and the #| fixtures,
# which are compared as text, stop matching. Keep them LF on every OS.
*.bend text eol=lf
*.ts text eol=lf
*.c text eol=lf
*.js text eol=lf
*.h text eol=lf
